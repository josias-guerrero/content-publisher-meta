# All variables are runtime-only. Never pass secrets as Docker build arguments.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/publisher.db
PUBLIC_BASE_URL=http://localhost:3000
# Required for every private request. Production: at least 32 characters.
API_KEY=
CONTEXT_SIGNING_SECRET=
# Explicit Coolify proxy addresses/CIDRs; empty means no trusted proxy.
TRUST_PROXY=
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_ID=v1
TOKEN_PREVIOUS_KEYS={}
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_FACEBOOK_APP_ID=
META_FACEBOOK_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
META_HTTP_TIMEOUT_MS=15000
# Exact controlled hostnames serving originals/derivatives, comma-separated.
MEDIA_ALLOWED_HOSTS=
# Enable only after format-specific evidence on designated assets (see docs/media-formats.md).
VERIFIED_FORMATS=
# Keep disabled through staging restore/backfill; enabling is an operator promotion gate.
WORKERS_ENABLED=false
EVENT_DESTINATION=
EVENT_SIGNING_SECRET=
LOG_LEVEL=info

# Bounded local inspection: default 256 MiB, hard maximum 1 GiB. ffprobe required.
MEDIA_MAX_BYTES=268435456
# Separate persistent volume; never restore this journal from a DB snapshot.
DELETION_LEDGER_PATH=
DELETION_LEDGER_SECRET=
# Only set true in an isolated test installation, for npm run check:staging.
STAGING_ONLY=false

# Explicitly enable only for the first deployment onto empty, new volumes.
BOOTSTRAP_NEW_INSTALLATION=false
# Separate backup and independent journal-replica volumes.
BACKUP_DIRECTORY=/backups
DELETION_REPLICA_DIRECTORY=/deletion-replica

# Server
HOST=127.0.0.1
PORT=3000

# Security
API_KEY=

# Database
DATABASE_PATH=./data/publisher.db

# Encryption
TOKEN_ENCRYPTION_KEY=

# Meta - Instagram (Instagram API with Instagram Login)
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=

# Meta - Facebook (Facebook Login for Business)
META_FACEBOOK_APP_ID=
META_FACEBOOK_APP_SECRET=

# Version de la Graph API para llamadas a Facebook (graph.facebook.com/v{version})
META_GRAPH_API_VERSION=v21.0

# URL publica (dominio/tunel) desde la que se accede a la API. Opcional.
# Si no se define, se deriva del request (x-forwarded-proto / host).
PUBLIC_BASE_URL=
